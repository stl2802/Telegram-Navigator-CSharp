<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:TelegramNavigator.Desktop.ViewModels"
		x:Class="TelegramNavigator.Desktop.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Title="Telegram Navigator"
		Icon="/Assets/app.ico"
		Width="1000" Height="700">
  <Window.KeyBindings>
	<KeyBinding Gesture="F1" Command="{Binding ShowHelpCommand}" />
	<KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
	<KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
	<KeyBinding Gesture="Ctrl+E" Command="{Binding ExportPdfCommand}" />
	<KeyBinding Gesture="Ctrl+T" Command="{Binding ToggleThemeCommand}" />
	<KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllForExportCommand}" />
	<KeyBinding Gesture="Escape" Command="{Binding ClearFiltersCommand}" />
  </Window.KeyBindings>
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="220,*">
	<StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="5">
	  <Button Content="Открыть" Command="{Binding OpenFileCommand}" />
	  <Button Content="Сбросить фильтры" Command="{Binding ClearFiltersCommand}" />
	  <Button Content="Тема" Command="{Binding ToggleThemeCommand}" />
	  <Button Content="Справка" Command="{Binding ShowHelpCommand}" />
	  <Button Content="Выбрать все" Command="{Binding SelectAllForExportCommand}" />
	</StackPanel>
	<StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
	  <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="{Binding IsBusy}" Width="200" />
	  <TextBlock Text="{Binding StatusText}" Margin="5" />
	</StackPanel>
	<ScrollViewer Grid.Row="1" Grid.Column="0" Margin="5">
	  <StackPanel Spacing="8" Margin="10">
		<TextBlock Text="ФИЛЬТРЫ" FontWeight="Bold" Margin="0 0 0 5" />
		<TextBox Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="Поиск" />
		<TextBlock Text="Автор" />
		<ComboBox ItemsSource="{Binding Authors}" SelectedItem="{Binding SelectedAuthor}" HorizontalAlignment="Stretch" />
		<TextBlock Text="От" />
		<DatePicker SelectedDate="{Binding DateFrom}" />
		<TextBlock Text="До" />
		<DatePicker SelectedDate="{Binding DateTo}" />
		<CheckBox Content="Только медиа" IsChecked="{Binding OnlyWithMedia}" />
		<CheckBox Content="Только ссылки" IsChecked="{Binding OnlyWithLinks}" />
	  </StackPanel>
	</ScrollViewer>
	<TabControl Grid.Row="1" Grid.Column="1" Margin="5">
	  <TabItem Header="Сообщения">
		<ListBox ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}">
		  <ListBox.ItemTemplate>
			<DataTemplate x:DataType="vm:MessageItemViewModel">
			  <StackPanel Spacing="4" Margin="4">
				<StackPanel Orientation="Horizontal" Spacing="6">
				  <CheckBox IsChecked="{Binding IsSelectedForExport}" Width="20" />
				  <TextBlock Text="{Binding Icon}" FontSize="16" />
				  <TextBlock Text="{Binding Author}" FontWeight="Bold" />
				  <TextBlock Text="{Binding DateText}" Foreground="Gray" />
				</StackPanel>
				<TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="600" />
			  </StackPanel>
			</DataTemplate>
		  </ListBox.ItemTemplate>
		</ListBox>
	  </TabItem>
	  <TabItem Header="Медиа">
		<ListBox ItemsSource="{Binding MediaItems}">
		  <ListBox.ItemTemplate>
			<DataTemplate x:DataType="vm:MessageItemViewModel">
			  <StackPanel Spacing="4" Margin="4">
				<StackPanel Orientation="Horizontal" Spacing="6">
				  <TextBlock Text="{Binding Icon}" FontSize="16" />
				  <TextBlock Text="{Binding Author}" FontWeight="Bold" />
				  <TextBlock Text="{Binding DateText}" Foreground="Gray" />
				</StackPanel>
				<TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
			  </StackPanel>
			</DataTemplate>
		  </ListBox.ItemTemplate>
		</ListBox>
	  </TabItem>
	  <TabItem Header="Ссылки">
		<ListBox ItemsSource="{Binding LinkItems}">
		  <ListBox.ItemTemplate>
			<DataTemplate x:DataType="vm:LinkEntryViewModel">
			  <StackPanel Spacing="4" Margin="4">
				<StackPanel Orientation="Horizontal" Spacing="6">
				  <TextBlock Text="{Binding Author}" FontWeight="Bold" />
				  <TextBlock Text="{Binding DateText}" Foreground="Gray" />
				</StackPanel>
				<TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
				<TextBlock Text="{Binding Url}" Foreground="Blue" TextWrapping="Wrap" />
			  </StackPanel>
			</DataTemplate>
		  </ListBox.ItemTemplate>
		</ListBox>
	  </TabItem>
	  <TabItem Header="Аналитика">
		<ScrollViewer>
		  <StackPanel Spacing="10" Margin="10">
			<TextBlock Text="Сводка" FontSize="16" FontWeight="Bold" />
			<StackPanel Orientation="Horizontal" Spacing="15" Margin="5">
			  <StackPanel Spacing="4">
				<TextBlock Text="{Binding Analytics.Summary.TotalMessages}" FontSize="20" FontWeight="Bold" />
				<TextBlock Text="сообщ" FontSize="11" />
			  </StackPanel>
			  <StackPanel Spacing="4">
				<TextBlock Text="{Binding Analytics.Summary.Participants}" FontSize="20" FontWeight="Bold" />
				<TextBlock Text="участ" FontSize="11" />
			  </StackPanel>
			  <StackPanel Spacing="4">
				<TextBlock Text="{Binding Analytics.Summary.MediaCount}" FontSize="20" FontWeight="Bold" />
				<TextBlock Text="медиа" FontSize="11" />
			  </StackPanel>
			  <StackPanel Spacing="4">
				<TextBlock Text="{Binding Analytics.Summary.LinkCount}" FontSize="20" FontWeight="Bold" />
				<TextBlock Text="ссылки" FontSize="11" />
			  </StackPanel>
			</StackPanel>
			<TextBlock Text="Топ авторов" FontSize="14" FontWeight="Bold" />
			<ItemsControl ItemsSource="{Binding Analytics.TopAuthors}">
			  <ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:BarItemViewModel">
				  <StackPanel Orientation="Horizontal" Spacing="3" Margin="2">
					<TextBlock Text="{Binding Value}" Width="30" />
					<TextBlock Text="{Binding Label}" Width="100" />
					<Border BorderBrush="Black" BorderThickness="1" Width="{Binding BarWidth}" Height="20" Background="{DynamicResource SystemAccentColor}" />
				  </StackPanel>
				</DataTemplate>
			  </ItemsControl.ItemTemplate>
			</ItemsControl>
			<TextBlock Text="По дням" FontSize="14" FontWeight="Bold" />
			<ItemsControl ItemsSource="{Binding Analytics.DailyActivity}">
			  <ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:BarItemViewModel">
				  <StackPanel Orientation="Horizontal" Spacing="3" Margin="2">
					<TextBlock Text="{Binding Label}" Width="60" />
					<Border BorderBrush="Black" BorderThickness="1" Width="{Binding BarWidth}" Height="16" Background="{DynamicResource SystemAccentColor}" />
					<TextBlock Text="{Binding Value}" Width="30" />
				  </StackPanel>
				</DataTemplate>
			  </ItemsControl.ItemTemplate>
			</ItemsControl>
			<TextBlock Text="По часам" FontSize="14" FontWeight="Bold" />
			<ItemsControl ItemsSource="{Binding Analytics.HourlyActivity}">
			  <ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:BarItemViewModel">
				  <StackPanel Orientation="Horizontal" Spacing="3" Margin="2">
					<TextBlock Text="{Binding Label}" Width="60" />
					<Border BorderBrush="Black" BorderThickness="1" Width="{Binding BarWidth}" Height="16" Background="{DynamicResource SystemAccentColor}" />
					<TextBlock Text="{Binding Value}" Width="30" />
				  </StackPanel>
				</DataTemplate>
			  </ItemsControl.ItemTemplate>
			</ItemsControl>
		  </StackPanel>
		</ScrollViewer>
	  </TabItem>
	</TabControl>
  </Grid>
</Window>
