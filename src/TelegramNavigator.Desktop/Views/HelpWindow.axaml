<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TelegramNavigator.Desktop.ViewModels"
        x:Class="TelegramNavigator.Desktop.Views.HelpWindow"
        x:DataType="vm:HelpViewModel"
        Title="Справка"
        Width="500"
        Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </Window.KeyBindings>
  <ScrollViewer Margin="10">
    <StackPanel Spacing="10">
      <TextBlock Text="{Binding HotkeysHelp}"
                 TextWrapping="Wrap"
                 FontFamily="Consolas, monospace"
                 LineHeight="20" />
      <Rectangle Height="1" Fill="{StaticResource SystemAccentColor}" Opacity="0.3" />
      <TextBlock Text="{Binding CliHelp}"
                 TextWrapping="Wrap"
                 FontFamily="Consolas, monospace"
                 LineHeight="20" />
    </StackPanel>
  </ScrollViewer>
</Window>